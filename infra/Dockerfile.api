# Build requires an operator-reviewed Python base-image digest; no floating default.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG UV_VERSION=0.12.18
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_NO_CACHE=1
WORKDIR /app
RUN python -m pip install --no-cache-dir "uv==${UV_VERSION}" \
    && groupadd --gid 10001 pais && useradd --uid 10001 --gid pais --create-home pais
COPY pyproject.toml uv.lock ./
COPY packages ./packages
RUN uv sync --frozen --no-dev --extra local --extra router --extra workflows --extra vectors \
    && mkdir -p /state /models && chown -R 10001:10001 /state
COPY services ./services
COPY projects/06-security-guardrails/pyproject.toml projects/06-security-guardrails/uv.lock ./projects/06-security-guardrails/
RUN uv sync --frozen --no-dev --project projects/06-security-guardrails
ENV PATH="/app/.venv/bin:$PATH" PAIS_DB_PATH=/state/pais.db PAIS_PROFILE=local \
    PAIS_GUARDRAILS_PYTHON=/app/projects/06-security-guardrails/.venv/bin/python \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 DO_NOT_TRACK=1
USER 10001:10001
EXPOSE 8000
STOPSIGNAL SIGTERM
CMD ["uvicorn", "services.api.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--timeout-graceful-shutdown", "90"]
