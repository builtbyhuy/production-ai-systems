# Fixture profile is deliberate and is never a production authentication setting.
PAIS_PROFILE=fixture
PAIS_ALLOW_FIXTURE_AUTH=1
PAIS_DB_PATH=var/pais.db
PAIS_OLLAMA_URL=http://127.0.0.1:11434
PAIS_MODEL_LOCK=models/local-models.lock.json
PAIS_LOCAL_THREADS=2
# Optional required Guardrails worker (absolute interpreter path, provision isolated env first):
# PAIS_GUARDRAILS_PYTHON=/absolute/path/projects/06-security-guardrails/.venv/bin/python
# No paid integrations or production secrets are configured by default.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
HF_HUB_DISABLE_TELEMETRY=1
DEEPEVAL_TELEMETRY_OPT_OUT=YES
RAGAS_DO_NOT_TRACK=true
CREWAI_TELEMETRY_ENABLED=false
